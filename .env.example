# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# Postgres container (read by docker-compose.yml)
POSTGRES_USER=filings
POSTGRES_PASSWORD=filings
POSTGRES_DB=filings
POSTGRES_PORT=5432

# App connection string (read by src/filings_rag/config.py)
DATABASE_URL=postgresql://filings:filings@localhost:5432/filings

# SEC EDGAR requires a name and contact email in the User-Agent (fair-access policy).
# Put your real value in .env only; this file is committed.
SEC_USER_AGENT="FilingsRAG Your Name you@example.com"
