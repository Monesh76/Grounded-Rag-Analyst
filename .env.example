# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# Postgres container (read by docker-compose.yml)
POSTGRES_USER=filings
POSTGRES_PASSWORD=filings
POSTGRES_DB=filings
POSTGRES_PORT=5432

# App connection string (read by src/filings_rag/config.py)
DATABASE_URL=postgresql://filings:filings@localhost:5432/filings

# SEC EDGAR requires a name and contact email in the User-Agent (fair-access policy).
# Put your real value in .env only; this file is committed.
SEC_USER_AGENT="FilingsRAG Your Name you@example.com"

# Embedding (P2). Voyage is the default embedder -- needed to embed both the
# corpus (make load) and every incoming question (make serve / the API).
VOYAGE_API_KEY=

# Generation (P4). LLM_PROVIDER picks which client get_llm_provider() builds;
# only that provider's key is required. "openrouter" (default) is cheapest for
# dev/testing; switch to "claude" or "openai" for final checks/production.
LLM_PROVIDER=openrouter
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Tracing (P6). Optional -- tracing.py is a no-op without both keys set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
